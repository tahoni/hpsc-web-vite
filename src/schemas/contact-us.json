{
  "title": "Contact Us",
  "description": "A Contact Us e-mail",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The name of the sender",
      "minLength": 3,
      "maxLength": 100
    },
    "email": {
      "type": "string",
      "title": "E-mail address",
      "description": "The e-mail of the sender",
      "minLength": 5,
      "maxLength": 100,
      "pattern": "/^[a-zA-Z0-9.!#$%&'*+\\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/"
    },
    "subject": {
      "type": "string",
      "title": "Subject",
      "description": "The subject of the e-mail",
      "enum": ["General", "Suggestions", "Complaints", "Website"],
      "default": "General",
      "minLength": 5,
      "maxLength": 100
    },
    "content": {
      "type": "string",
      "title": "Message",
      "description": "The e-mail content",
      "minLength": 5,
      "maxLength": 1000
    }
  },
  "required": ["name", "email", "subject", "content"],
  "x-apidog-orders": ["name", "email", "subject", "content"]
}
