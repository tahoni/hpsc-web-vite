{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies",
      "type": "npm",
      "script": "install",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "options": {
        "env": {
          "NPM_TOKEN": "${env:NPM_TOKEN_READ}"
        },
        "detail": "Installs project dependencies using npm"
      }
    },
    {
      "label": "Run Dev Server",
      "type": "npm",
      "script": "dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "options": {
        "env": {
          "GOOGLE_API_KEY": "${env:GOOGLE_API_KEY_DEV}",
          "RECAPTCHA_V2_SITE_KEY": "${env:RECAPTCHA_V2_SITE_KEY_DEV}"
        }
      },
      "detail": "Runs the Vite development server"
    },
    {
      "label": "Build Project",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "env": {
          "GOOGLE_API_KEY": "${env:GOOGLE_API_KEY_LIVE}",
          "RECAPTCHA_V2_SITE_KEY": "${env:RECAPTCHA_V2_SITE_KEY_LIVE}"
        }
      },
      "problemMatcher": [],
      "detail": "Builds the project using Vite"
    },
    {
      "label": "Preview Build",
      "type": "npm",
      "script": "preview",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Previews the built project using Vite"
    },
    {
      "label": "Run Tests",
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Runs tests using Vitest"
    },
    {
      "label": "Lint Code",
      "type": "npm",
      "script": "lint",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Runs ESLint on the codebase"
    },
    {
      "label": "Fix Vulnerabilities",
      "type": "npm",
      "script": "audit",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Fixes vulnerabilities in the project dependencies"
    },
    {
      "label": "Run Audit",
      "type": "shell",
      "command": "npm audit",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Runs npm audit to check for vulnerabilities"
    },
    {
      "label": "Fix Vulnerabilities",
      "type": "shell",
      "command": "npm audit fix",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Fixes vulnerabilities in the project dependencies"
    }
  ]
}
