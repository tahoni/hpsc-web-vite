# Copy this file to .env.local and fill in real values — see AGENTS.md's Environment Variables section for details.

# The URL of the website.
VITE_SITE_URL=

# Whether to show breakpoints in the UI.
VITE_SHOW_BREAKPOINTS=

# Google Maps API key; without it the venue map does not render.
VITE_GOOGLE_MAPS_API_KEY=

# reCAPTCHA v2 site key for the Contact Us form's Captcha component.
VITE_RECAPTCHA_V2_SITE_KEY=

# Read-only GitHub Packages token to install the @tahoni scope (tahoni-lib-react).
# Not read from a .env file — export it in your shell (or CI secrets) so .npmrc's
# ${NPM_TOKEN_READ} substitution resolves during `npm install`.
# NPM_TOKEN_READ=
